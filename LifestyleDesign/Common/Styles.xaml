<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared look for Lifestyle Design windows.
        Change a color here and every window that merges this dictionary follows.

        To use in a window:

        <Window.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/LifestyleDesign;component/Common/Styles.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Window.Resources>
    -->

    <!-- Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="White"/>
    <SolidColorBrush x:Key="WindowBorderBrush"      Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TitleBarBrush"          Color="#2B5A8E"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush"     Color="#1E4A7A"/>
    <SolidColorBrush x:Key="TitleBarTextBrush"      Color="White"/>
    <SolidColorBrush x:Key="TitleBarDividerBrush"   Color="#E5E7EB"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="#2B5A8E"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush"  Color="#E5E7EB"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"       Color="#D1D5DB"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"     Color="#9CA3AF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush"      Color="#9CA3AF"/>
    <SolidColorBrush x:Key="SeparatorBrush"         Color="#9CA3AF"/>
    <SolidColorBrush x:Key="MessageTextBrush"       Color="#1F2937"/>

    <!-- Message dialog icon colors -->
    <SolidColorBrush x:Key="InformationBrush"       Color="#2B5A8E"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="#D97706"/>
    <SolidColorBrush x:Key="ErrorBrush"             Color="#DC2626"/>

    <!-- Outer window frame with rounded corners -->
    <Style x:Key="WindowFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WindowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- Title bar -->
    <Style x:Key="TitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TitleBarBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TitleBarDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
    </Style>

    <Style x:Key="TitleBarText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleBarTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="15,0,0,0"/>
    </Style>

    <!-- The "×" button at the right end of the title bar -->
    <Style x:Key="TitleBarCloseButton" TargetType="Button">
        <Setter Property="Content" Value="×"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource TitleBarTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TitleBarHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Standard OK / Cancel / Help button -->
    <Style x:Key="StyledButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Underlined text link, such as Check All / Check None -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               TextDecorations="Underline"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
